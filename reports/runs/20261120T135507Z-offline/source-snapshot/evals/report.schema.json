{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suhail.invalid/schemas/evaluation-report-v1",
  "title": "Suhail executed evaluation report",
  "description": "Contract for reports implemented by Codex. No values in this schema are observed benchmark results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "evidence_mode", "component", "started_at", "finished_at", "provenance", "counts", "metrics", "usage", "errors", "limitations", "reproduce_command"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["NOT_RUN", "BLOCKED", "PARTIAL", "COMPLETE"]},
    "reason_code": {"type": ["string", "null"]},
    "evidence_mode": {"enum": ["deterministic_software", "mocked_provider", "live_groq_synthetic", "adapted_external", "optional_local_research"]},
    "component": {"enum": ["intake", "pathway_router", "safety_escalation", "patient_navigator", "coordination", "closure_evidence", "journeys", "software_suite", "external_suite"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "required": ["code_revision", "provider", "model", "dataset", "dataset_revision", "selected_case_ids", "prompt_hash", "retrieval_hash", "scorer_version"],
      "properties": {
        "code_revision": {"type": ["string", "null"]},
        "dirty_state_hash": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "grader_model": {"type": ["string", "null"]},
        "dataset": {"type": "string"},
        "dataset_revision": {"type": ["string", "null"]},
        "dataset_checksum": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "selected_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prompt_hash": {"type": ["string", "null"]},
        "retrieval_hash": {"type": ["string", "null"]},
        "policy_hash": {"type": ["string", "null"]},
        "scorer_version": {"type": ["string", "null"]},
        "sampling_parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["selected", "attempted", "completed", "failed", "skipped"],
      "properties": {
        "selected": {"type": "integer", "minimum": 0},
        "attempted": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "task_passed": {"type": ["integer", "null"], "minimum": 0},
        "task_incorrect": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "usage": {
      "type": "object",
      "required": ["api_calls", "input_tokens", "output_tokens", "cost_usd", "latency_ms_p50", "latency_ms_p95"],
      "properties": {
        "api_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "latency_ms_p50": {"type": ["number", "null"], "minimum": 0},
        "latency_ms_p95": {"type": ["number", "null"], "minimum": 0},
        "price_map_version": {"type": ["string", "null"]},
        "budget_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"case_id": {"type": ["string", "null"]}, "code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "reproduce_command": {"type": ["string", "null"]}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["name", "value", "unit", "denominator", "method"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "denominator": {"type": ["integer", "null"], "minimum": 0},
        "method": {"type": "string"},
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "COMPLETE"}}}, "then": {"properties": {"counts": {"properties": {"selected": {"minimum": 1}, "attempted": {"minimum": 1}, "completed": {"minimum": 1}, "skipped": {"const": 0}}}}}},
    {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"properties": {"counts": {"properties": {"completed": {"const": 0}}}, "metrics": {"items": {"properties": {"value": {"type": "null"}}}}}}},
    {"if": {"properties": {"status": {"const": "NOT_RUN"}}}, "then": {"properties": {"counts": {"properties": {"attempted": {"const": 0}, "completed": {"const": 0}, "failed": {"const": 0}}}, "metrics": {"items": {"properties": {"value": {"type": "null"}}}}, "usage": {"properties": {"api_calls": {"const": 0}}}}}},
    {"if": {"properties": {"evidence_mode": {"const": "live_groq_synthetic"}, "status": {"enum": ["COMPLETE", "PARTIAL"]}}, "required": ["evidence_mode", "status"]}, "then": {"properties": {"usage": {"properties": {"api_calls": {"minimum": 1}}}, "provenance": {"properties": {"provider": {"const": "groq"}, "model": {"type": "string", "minLength": 1}}}}}}
  ]
}
