# Secret-free example. Parse server-side with dotenv; never source this file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_GRADER_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=3
GROQ_MAX_CONCURRENCY=2
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_MAX_TOOL_STEPS=6
BENCHMARK_PRESET=smoke
BENCHMARK_MAX_API_CALLS=300
BENCHMARK_MAX_TOTAL_TOKENS=300000
BENCHMARK_MAX_CONCURRENCY=2
BENCHMARK_MAX_COST_USD=
BENCHMARK_HEALTHBENCH_CASES=12
BENCHMARK_SYNTHETIC_CASES_PER_AGENT=6
BENCHMARK_LIVE_JOURNEY_CASES=6
DEMO_MODE=true
SESSION_SECURE=false
ALLOW_RESTRICTED_DATA_REMOTE=false
ENABLE_OPTIONAL_MEDAGENTBENCH=false
ENABLE_OPTIONAL_MIMIC=false
# Optional read-only workspace question interpretation; factual answers use records.
# This persistent application ledger is separate from immutable benchmark runs.
CHAT_LLM_ENABLED=false
CHAT_MAX_CALLS=20
CHAT_MAX_TOKENS=40000
CHAT_MAX_OUTPUT_TOKENS=1024
# Normal hosting: DEMO_MODE=false, SESSION_SECURE=true, HTTPS and approved accounts.
# Generate local DB/session/demo credentials separately in ignored .runtime/.
