# This is a template only. The owner supplies the actual secret in a private external file.
# The application reads that file server-side via APP_ENV_FILE; never shell-source it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=3
GROQ_MAX_CONCURRENCY=2
AGENT_MAX_TOOL_STEPS=6
AGENT_MAX_OUTPUT_TOKENS=1500

# Explicit modes: live, templates. A provider failure is never silently relabelled live success.
AGENT_MODE=live
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
APP_ENV_FILE=
APP_SESSION_SECRET=
DATABASE_URL=
NOTIFICATION_MODE=local_outbox
ALLOW_REAL_NOTIFICATIONS=false

# Live benchmark limits count all target, grader, retry and capability-check requests.
BENCHMARK_PRESET=smoke
BENCHMARK_MAX_API_CALLS=300
BENCHMARK_MAX_TOTAL_TOKENS=300000
BENCHMARK_MAX_CONCURRENCY=2
# Optional USD ceiling. If set, current verified model prices are required before a run.
BENCHMARK_MAX_COST_USD=
BENCHMARK_HEALTHBENCH_CASES=12
BENCHMARK_SYNTHETIC_CASES_PER_AGENT=6
BENCHMARK_LIVE_JOURNEY_CASES=6

# Set a grader explicitly. Same-family grading must be identified as adapted and potentially biased.
GROQ_GRADER_MODEL=openai/gpt-oss-120b
ALLOW_RESTRICTED_DATA_REMOTE=false
ENABLE_OPTIONAL_MEDAGENTBENCH=false
ENABLE_OPTIONAL_MIMIC=false
